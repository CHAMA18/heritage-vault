# ── HeritageVault × Genblaze worker — environment ──────────────────────
# Copy to .env, fill in, then:  set -a && source .env && set +a
# (or load via your host: Railway/Render/Replit/etc.)

# Backblaze B2 — create a bucket + application key, then set these:
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=heritage-vault-media
# Optional: the region your bucket lives in (e.g. us-west-004, eu-central-003)
# — avoids a one-time redirect hop.
B2_REGION=
# For PUBLIC buckets, the permanent URL base so assets get durable URLs:
#   https://fNNN.backblazeb2.com/file/<your-bucket>
B2_PUBLIC_URL_BASE=

# ElevenLabs TTS (narration voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# OpenAI DALL·E (archival illustration)
OPENAI_API_KEY=

# Optional pipeline tuning
GENBLAZE_TTS_MODEL=eleven_v3
GENBLAZE_IMAGE_MODEL=dall-e-3
