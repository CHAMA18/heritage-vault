# ──────────────────────────────────────────────────────────────────────
# HeritageAtlas — environment variables
# Never commit a real .env file. Copy this to .env and fill in.
# ──────────────────────────────────────────────────────────────────────

# ── ClickHouse (primary database) ─────────────────────────────────────
# Used by:
#   - trigger/agent-chat.ts      (chat.agent() tools query ClickHouse)
#   - trigger/ingest-demo-archive.ts  (loads demo dataset into ClickHouse)
#   - scripts/apply-clickhouse-schema.mjs  (applies clickhouse/schema.sql)
CLICKHOUSE_URL=https://your-clickhouse-service.clickhouse.cloud:8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=default

# ── Trigger.dev (worker runtime + chat.agent() orchestration) ─────────
# Server-side secret. Used by `npx trigger.dev@latest dev` / `deploy`.
TRIGGER_PROJECT_REF=proj_replace_me
TRIGGER_SECRET_KEY=tr_dev_replace_me

# ── Vite env (exposed to browser — safe to ship) ──────────────────────
# When BOTH are set, the chat UI uses the live Trigger.dev + ClickHouse
# path. When either is missing, it falls back to the local mock runtime
# (same VizSpec shape, same UX, no external dependencies).
#
# VITE_TRIGGER_PROJECT_REF: your Trigger.dev project ref (same as
#   TRIGGER_PROJECT_REF). Used by the browser transport to build the
#   cloud URL.
# VITE_TRIGGER_PUBLIC_TOKEN: a public token (NOT the secret key) the
#   browser sends to your backend's /api/chat/:id/access-token endpoint.
#   The backend uses the secret key to mint a session-scoped PAT.
VITE_TRIGGER_PROJECT_REF=
VITE_TRIGGER_PUBLIC_TOKEN=
