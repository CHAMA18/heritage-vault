# ---------------------------------------------------------------------
# HeritageVault - environment variables
# Never commit a real .env file. Copy this to .env and fill in.
# ---------------------------------------------------------------------

# --- Backblaze B2 + Genblaze (media pipeline) -------------------------
# Server-side only. The Python worker (genblaze-worker/) reads the B2 +
# provider keys and uploads generated media + SHA-256 provenance manifests
# to Backblaze B2. The Vite middleware proxies /api/genblaze/* to it.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=heritage-vault-media
# For a PUBLIC bucket: https://fNNN.backblazeb2.com/file/<bucket> so assets
# get permanent credential-free URLs.
B2_PUBLIC_URL_BASE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
OPENAI_API_KEY=
# Where the Genblaze worker lives (uvicorn server:app --port 8787 locally).
GENBLAZE_WORKER_URL=http://127.0.0.1:8787

# --- Auth -------------------------------------------------------------
# Firebase config is bundled in src/firebase.ts for the static deploy - no
# variables required. Everything else (the Agent, the Atlas, Story Mode)
# runs entirely in-browser from the archive store.
